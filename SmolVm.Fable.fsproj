<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SmolVm.Fable</AssemblyName>
    <RootNamespace>SmolVm</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="5.*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/Types.fs" />
    <Compile Include="src/Errors.fs" />
    <Compile Include="src/Execution.fs" />
    <Compile Include="src/Internal/Interop.fs" />
    <Compile Include="src/Container.fs" />
    <Compile Include="src/Machine.fs" />
    <Compile Include="src/Presets/Node.fs" />
  </ItemGroup>

</Project>
